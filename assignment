int main()
{
 enqueue(10);
 enqueue(20);
 enqueue(30);
 enqueue(40);
 display();
 insertAt(2, 25);
 display();
 insertAt(9, 77);
 insertAt(1, 5);
 display();
 insertAt(3, 99);
