#include <stdio.h>
#define MAX 6
int queue[MAX];
int front = -1, rear = -1;
void display()
{
 if (front == -1)
 {
 printf("Q is empty!\n");
 return;
 }
 printf("Queue: ");
 for (int i = front; i <= rear; i++)
 printf("%d ", queue[i]);
 printf("\n");
}
void enqueue(int x)
{
 if (rear == MAX - 1)
 {
 printf("Q is FULL!\n");
 }
 else
 {
 if (front == -1)
 front = 0;
 rear++;
 queue[rear] = x;
 printf("%d has been queued\n", x);
 }
}
/* Insert x at a chosen position (1 = front of the queue) */
void insertAt(int pos, int x)
{
 int count = (front == -1) ? 0 : rear - front + 1;
 if (rear == MAX - 1)
 {
 printf("Q is FULL! Cannot insert %d\n", x);
 }
 else if (pos < 1 || pos > count + 1)
 {
 printf("Invalid position %d\n", pos);
 }
 else
 {
 if (front == -1)
 front = 0;
 int index = front + pos - 1;
 for (int i = rear; i >= index; i--) /* shift right */
 queue[i + 1] = queue[i];
 queue[index] = x;
 rear++;
 printf("%d inserted at position %d\n", x, pos);
 }
}
